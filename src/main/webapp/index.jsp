<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Smart Study Planner</title>
<style>
:root{--blue:#526cf5;--purple:#8059e8;--ink:#202944;--muted:#7c879f;--line:#e8ecf6;--bg:#f5f7ff;--green:#20ad82}*{box-sizing:border-box}body{margin:0;background:var(--bg);font:14px 'Segoe UI',Arial,sans-serif;color:var(--ink)}button,input,select,textarea{font:inherit}button{cursor:pointer}.layout{display:flex;min-height:100vh}.side{width:230px;flex-shrink:0;background:white;border-right:1px solid var(--line);padding:24px 16px;display:flex;flex-direction:column}.brand{font-size:20px;font-weight:850;margin:0 0 32px 8px}.brand b{color:var(--blue)}.navlabel{font-size:10px;letter-spacing:1.5px;color:#a0a8ba;font-weight:bold;margin:0 0 10px 10px}.nav{display:grid;gap:6px}.nav button{border:0;background:transparent;color:#78829a;text-align:left;padding:13px;border-radius:11px;font-weight:700}.nav button.active,.nav button:hover{background:#eef1ff;color:var(--blue)}.tip{margin-top:auto;background:#f0eeff;color:#6552b9;border-radius:14px;padding:16px;line-height:1.5}.tip b{display:block;color:#3f347f;margin-bottom:5px}.main{padding:26px 30px 40px;width:100%;max-width:1550px;margin:auto;min-width:0}.top{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:23px}.eyebrow{color:var(--muted);font-size:11px;font-weight:bold}.top h1{margin:5px 0 0;font-size:28px}.topright{display:flex;align-items:center;gap:10px}.pill{background:white;border:1px solid var(--line);border-radius:10px;padding:11px;color:#66718a}.primary,.secondary{border:0;border-radius:10px;padding:12px 16px;font-weight:750}.primary{background:linear-gradient(120deg,var(--blue),var(--purple));color:white}.secondary{background:#eef1ff;color:var(--blue)}.hero{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:26px 28px;border-radius:20px;color:white;background:linear-gradient(110deg,#4e6cf5,#815de7)}.hero h2{margin:0 0 8px;font-size:24px}.hero p{margin:0;color:#e9ebff}.heroDate{background:#ffffff22;border:1px solid #ffffff3b;border-radius:13px;padding:14px 22px;text-align:center}.heroDate b{display:block;font-size:25px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}.stat,.panel{background:white;border:1px solid var(--line);border-radius:16px;padding:19px;min-width:0}.stat .label{color:var(--muted);font-weight:700;font-size:12px}.stat .num{font-size:29px;font-weight:850;margin:11px 0 4px}.stat small{color:var(--muted)}.columns{display:grid;grid-template-columns:1.35fr .85fr;gap:18px}.panel{margin-bottom:18px}.panelhead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:17px}.panelhead h3{margin:0;font-size:17px}.sub{color:var(--muted);font-size:12px;margin-top:5px}.link{border:0;background:none;color:var(--blue);font-weight:bold}.progressrow{display:flex;align-items:center;gap:12px;margin-bottom:16px}.track{height:8px;border-radius:20px;background:#edf0fa;overflow:hidden;flex:1}.fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--purple));width:0;transition:width .2s}.muted{color:var(--muted);font-size:12px;white-space:nowrap}.tasks{display:grid;gap:9px}.task{display:flex;align-items:center;gap:11px;border:1px solid #edf0f7;border-radius:12px;padding:12px;min-width:0}.taskInfo{flex:1;min-width:0}.taskName{font-weight:750;overflow-wrap:anywhere}.task.done .taskName{text-decoration:line-through;color:#9ca4b5}.meta{display:flex;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:11px;margin-top:6px}.tag{background:#eef1ff;color:#5366cb;padding:4px 7px;border-radius:6px}.priority{padding:4px 7px;border-radius:6px;font-size:10px;font-weight:bold}.High{background:#fff0f1;color:#ce5268}.Medium{background:#fff5e6;color:#b77d24}.Low{background:#e7f8f1;color:#178a66}.check{width:19px;height:19px;accent-color:var(--green);flex-shrink:0}.taskActions{display:flex;gap:4px}.taskActions button{border:0;background:#f5f6fb;color:#78829a;border-radius:7px;padding:7px}.subjectList{display:grid;gap:14px}.subjectRow{display:flex;align-items:center;gap:10px}.dot{width:10px;height:10px;border-radius:4px;flex-shrink:0}.subjectBody{flex:1;min-width:0}.subjectTitle{font-size:12px;font-weight:750}.smallTrack{height:5px;background:#edf0f8;border-radius:9px;margin-top:7px;overflow:hidden}.smallTrack span{height:100%;display:block;border-radius:9px}.subjectNum{font-size:11px;color:var(--muted)}.empty{text-align:center;padding:25px 12px;color:var(--muted);line-height:1.7}.view{display:none}.view.active{display:block}.tools{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:15px}.tools input{flex:1;min-width:170px}.tools input,.tools select,.field input,.field select,.field textarea{border:1px solid #e1e6f1;border-radius:9px;padding:11px;background:white;color:var(--ink);width:100%;outline:none}.tools select{width:auto;min-width:130px}.field input:focus,.field select:focus,.field textarea:focus,.tools input:focus{border-color:#899bff}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:grid;gap:7px}.field label{font-size:12px;font-weight:750;color:#5c6780}.field.full{grid-column:1/-1}.field textarea{min-height:90px;resize:vertical}.formactions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}.calendarLayout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(230px,.7fr);gap:18px}.calToolbar{display:flex;align-items:center;gap:8px;margin-bottom:12px}.calToolbar strong{min-width:130px;text-align:center}.calToolbar button{border:0;background:#f0f2fc;border-radius:8px;padding:8px 12px;color:var(--blue)}.calGrid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.weekday{text-align:center;font-size:10px;color:#919bb0;font-weight:bold;padding:8px 0}.day{min-height:76px;border:1px solid #edf0f7;border-radius:9px;padding:7px;cursor:pointer;background:#fff;min-width:0}.day:hover{border-color:#9caaff}.day.other{opacity:.35}.day.today{border-color:var(--blue);background:#f3f5ff}.day.selected{box-shadow:inset 0 0 0 1px var(--blue)}.daynum{font-size:11px;font-weight:bold}.event{display:block;font-size:9px;margin-top:5px;padding:3px;border-radius:4px;background:#e9edff;color:#5366cb;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.event.done{background:#e6f8f0;color:#168660}.selectedBox{background:#f7f8ff;border-radius:12px;padding:14px}.selectedBox h4{margin:0 0 12px}.notice{display:none;padding:11px;border-radius:9px;margin-bottom:12px}.notice.show{display:block}.notice.error{background:#fff0f1;color:#bf4158}.notice.success{background:#e7f9f1;color:#177b5d}.settingsRow{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:16px 0;border-bottom:1px solid var(--line)}.settingsRow:last-child{border:0}.settingsRow p{margin:5px 0 0;color:var(--muted);font-size:12px}.toast{position:fixed;bottom:20px;right:20px;background:#202944;color:white;padding:13px 17px;border-radius:10px;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:none}footer{text-align:center;color:#a0a8ba;font-size:11px;margin-top:10px}
@media(max-width:1050px){.side{width:200px}.main{padding:22px}.stats{grid-template-columns:repeat(2,1fr)}.columns{grid-template-columns:1fr}.calendarLayout{grid-template-columns:1fr}}@media(max-width:680px){.layout{display:block}.side{width:100%;padding:12px;border:0;border-bottom:1px solid var(--line)}.brand{margin:0 0 10px 5px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap;padding:10px;font-size:12px}.navlabel,.tip{display:none}.main{padding:17px 12px}.top{align-items:flex-start;flex-direction:column}.topright{width:100%;justify-content:space-between}.top h1{font-size:24px}.hero{padding:21px}.hero h2{font-size:20px}.heroDate{display:none}.stats{gap:9px}.stat{padding:13px}.stat .num{font-size:25px}.panel{padding:14px}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.day{min-height:56px;padding:4px}.event{font-size:8px}.tools select{flex:1}.calGrid{gap:3px}}
</style></head><body>
<div class="layout"><aside class="side"><div class="brand">✦ Study<b>Planner</b></div><div class="navlabel">WORKSPACE</div><nav class="nav"><button class="active" data-view="dashboard">▦ &nbsp;Dashboard</button><button data-view="tasks">☑ &nbsp;All Tasks</button><button data-view="calendar">▦ &nbsp;Calendar</button><button data-view="add">＋ &nbsp;Add Task</button><button data-view="subjects">◈ &nbsp;Subjects</button><button data-view="settings">⚙ &nbsp;Settings</button></nav><div class="tip"><b>✧ Small steps, big results</b>Stay consistent. Every focused session brings you closer to your goal.</div></aside>
<main class="main"><header class="top"><div><div class="eyebrow" id="topDate">YOUR PERSONAL STUDY SPACE</div><h1 id="pageTitle">Dashboard</h1></div><div class="topright"><div class="pill" id="todayPill">📅 Today</div><button class="primary" data-goto="add">＋ Add task</button></div></header>
<section class="view active" id="view-dashboard"><div class="hero"><div><h2 id="greeting">Let's make today count! ✨</h2><p>Plan your learning, track your progress, and celebrate every little win.</p></div><div class="heroDate"><b id="heroDay">--</b><span id="heroMonth">TODAY</span></div></div>
<div class="stats"><div class="stat"><div class="label">TOTAL TASKS</div><div class="num" id="totalCount">0</div><small>Tasks in your planner</small></div><div class="stat"><div class="label">COMPLETED</div><div class="num" id="doneCount">0</div><small>Keep up the great work</small></div><div class="stat"><div class="label">PENDING</div><div class="num" id="pendingCount">0</div><small>Ready for your focus</small></div><div class="stat"><div class="label">COMPLETION</div><div class="num" id="percentCount">0%</div><small>Overall progress</small></div></div>
<div class="columns"><section class="panel"><div class="panelhead"><div><h3>Today's tasks</h3><div class="sub">Your plan for today</div></div><button class="link" data-goto="tasks">View all →</button></div><div class="progressrow"><div class="track"><div class="fill" id="todayFill"></div></div><span class="muted" id="todayProgress">0 of 0 done</span></div><div class="tasks" id="todayTasks"></div></section><section class="panel"><div class="panelhead"><div><h3>Subject overview</h3><div class="sub">Tasks by subject</div></div><button class="link" data-goto="subjects">Details →</button></div><div class="subjectList" id="subjectOverview"></div></section></div>
<section class="panel"><div class="panelhead"><div><h3>Study calendar</h3><div class="sub">Tasks scheduled this month</div></div><button class="link" data-goto="calendar">Open calendar →</button></div><div class="calToolbar"><button id="miniPrev">‹</button><strong id="miniTitle"></strong><button id="miniNext">›</button></div><div class="calGrid" id="miniCalendar"></div></section></section>
<section class="view" id="view-tasks"><section class="panel"><div class="panelhead"><div><h3>All study tasks</h3><div class="sub">Search, filter, edit, complete or delete tasks.</div></div><button class="primary" data-goto="add">＋ New task</button></div><div class="tools"><input id="searchTasks" type="search" placeholder="Search tasks or notes…"><select id="filterSubject"><option value="all">All subjects</option></select><select id="filterStatus"><option value="all">All statuses</option><option value="pending">Pending</option><option value="completed">Completed</option></select><select id="filterPriority"><option value="all">All priorities</option><option>High</option><option>Medium</option><option>Low</option></select></div><div class="tasks" id="allTasks"></div></section></section>
<section class="view" id="view-calendar"><section class="panel"><div class="panelhead"><div><h3>Study calendar</h3><div class="sub">Select any date to see or schedule tasks.</div></div><button class="primary" id="calendarAdd">＋ Add task</button></div><div class="calendarLayout"><div><div class="calToolbar"><button id="calPrev">‹</button><strong id="calTitle"></strong><button id="calNext">›</button><button id="calToday" style="margin-left:auto">Today</button></div><div class="calGrid" id="fullCalendar"></div></div><aside class="selectedBox"><h4 id="selectedTitle">Tasks for selected date</h4><div class="tasks" id="selectedTasks"></div></aside></div></section></section>
<section class="view" id="view-add"><section class="panel" style="max-width:780px"><div class="panelhead"><div><h3 id="formHeading">Create a study task</h3><div class="sub">Give your next study session a clear plan.</div></div></div><div class="notice" id="formNotice"></div><form id="taskForm"><input type="hidden" id="editId"><div class="formgrid"><div class="field full"><label for="taskName">Task name *</label><input id="taskName" maxlength="120" required placeholder="e.g. Practice 5 DSA problems"></div><div class="field"><label for="taskSubject">Subject *</label><select id="taskSubject" required></select></div><div class="field"><label for="taskPriority">Priority</label><select id="taskPriority"><option>Medium</option><option>High</option><option>Low</option></select></div><div class="field"><label for="taskDate">Due date *</label><input type="date" id="taskDate" required></div><div class="field"><label for="taskTime">Study time</label><input type="time" id="taskTime" value="16:00"></div><div class="field full"><label for="taskNotes">Notes (optional)</label><textarea id="taskNotes" maxlength="500" placeholder="What do you want to cover in this session?"></textarea></div></div><div class="formactions"><button type="button" class="secondary" id="cancelForm">Cancel</button><button type="submit" class="primary" id="saveBtn">Save task</button></div></form></section></section>
<section class="view" id="view-subjects"><section class="panel"><div class="panelhead"><div><h3>Subject tracker</h3><div class="sub">Track tasks and completion for every subject.</div></div><button class="primary" data-goto="add">＋ Add task</button></div><div class="subjectList" id="subjectsPage"></div></section></section>
<section class="view" id="view-settings"><section class="panel"><div class="panelhead"><div><h3>Settings & data</h3><div class="sub">Tasks are saved in this browser on this device.</div></div></div><div class="settingsRow"><div><b>Export tasks</b><p>Download a backup of your study tasks.</p></div><button class="secondary" id="exportBtn">Export JSON</button></div><div class="settingsRow"><div><b>Import tasks</b><p>Restore a JSON backup from this planner.</p></div><label class="secondary" for="importFile" style="cursor:pointer">Choose file</label><input hidden type="file" id="importFile" accept="application/json,.json"></div><div class="settingsRow"><div><b>Clear all tasks</b><p>Permanently remove all tasks saved in this browser.</p></div><button class="primary" id="clearBtn" style="background:#e45d75">Clear all</button></div></section></section><footer>Smart Study Planner · Build good habits, one task at a time.</footer></main></div><div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
(()=>{'use strict';
const KEY='smartStudyPlannerTasks_v3', OLD_KEYS=['smartStudyPlannerTasks_v2','smartStudyPlannerTasks'];
const SUBJECTS=[['Data Structures & Algorithms','#526cf5'],['Java','#f19a45'],['Aptitude','#20ad82'],['DBMS','#a16be0'],['Operating Systems','#e36c87'],['Computer Networks','#37a6c7'],['Web Development','#d5ad27'],['Other','#8993a8']];
const $=id=>document.getElementById(id);let tasks=[],monthCursor=new Date(),selectedDate=isoToday(),toastTimer;
function isoToday(){let d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function iso(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function parseDate(s){return new Date(s+'T12:00:00')}
function niceDate(s,opts={weekday:'short',month:'short',day:'numeric'}){return parseDate(s).toLocaleDateString(undefined,opts)}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function id(){return crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random().toString(36).slice(2)}
function toast(msg){$('toast').textContent=msg;$('toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').classList.remove('show'),2500)}
function load(){let raw=localStorage.getItem(KEY);if(!raw){for(const k of OLD_KEYS){raw=localStorage.getItem(k);if(raw)break}}try{const a=raw?JSON.parse(raw):[];tasks=Array.isArray(a)?a.filter(t=>t&&typeof(t.name||t.title)==='string').map(t=>({id:String(t.id||id()),name:String(t.name||t.title),subject:SUBJECTS.some(s=>s[0]===(t.subject||t.category))?(t.subject||t.category):'Other',date:/^\d{4}-\d{2}-\d{2}$/.test(t.date||t.dueDate||'')?(t.date||t.dueDate):isoToday(),time:/^\d{2}:\d{2}$/.test(t.time||'')?t.time:'16:00',priority:['High','Medium','Low'].includes(t.priority)?t.priority:'Medium',notes:String(t.notes||''),completed:!!t.completed,createdAt:t.createdAt||new Date().toISOString()})):[]}catch(e){tasks=[];toast('Saved data could not be read.')}save()}
function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks));return true}catch(e){toast('Could not save: browser storage is unavailable.');return false}}
function sort(list){return [...list].sort((a,b)=>Number(a.completed)-Number(b.completed)||a.date.localeCompare(b.date)||(a.time||'').localeCompare(b.time||''))}
function taskHTML(t){return `<article class="task ${t.completed?'done':''}"><input class="check" type="checkbox" aria-label="Complete task" data-action="toggle" data-id="${esc(t.id)}" ${t.completed?'checked':''}><div class="taskInfo"><div class="taskName">${esc(t.name)}</div><div class="meta"><span class="tag">${esc(t.subject)}</span><span>📅 ${esc(niceDate(t.date))}</span><span>◷ ${esc(t.time||'Any time')}</span><span class="priority ${t.priority}">${esc(t.priority)}</span></div>${t.notes?`<div class="meta">${esc(t.notes)}</div>`:''}</div><div class="taskActions"><button type="button" data-action="edit" data-id="${esc(t.id)}" aria-label="Edit task" title="Edit">✎</button><button type="button" data-action="delete" data-id="${esc(t.id)}" aria-label="Delete task" title="Delete">×</button></div></article>`}
function empty(msg){return `<div class="empty">✧<br>${esc(msg)}<br><button class="link" data-goto="add">＋ Add a task</button></div>`}
function renderDashboard(){let total=tasks.length,done=tasks.filter(t=>t.completed).length,pending=total-done,pct=total?Math.round(done/total*100):0;$('totalCount').textContent=total;$('doneCount').textContent=done;$('pendingCount').textContent=pending;$('percentCount').textContent=pct+'%';let today=sort(tasks.filter(t=>t.date===isoToday())),td=today.filter(t=>t.completed).length;$('todayFill').style.width=(today.length?td/today.length*100:0)+'%';$('todayProgress').textContent=`${td} of ${today.length} done`;$('todayTasks').innerHTML=today.length?today.map(taskHTML).join(''):empty('No tasks planned for today. Add a task to get started.');renderSubjects();renderMiniCalendar()}
function renderSubjects(){const html=SUBJECTS.map(([name,color])=>{let a=tasks.filter(t=>t.subject===name),d=a.filter(t=>t.completed).length,p=a.length?Math.round(d/a.length*100):0;return `<div class="subjectRow"><span class="dot" style="background:${color}"></span><div class="subjectBody"><div class="subjectTitle">${esc(name)}</div><div class="smallTrack"><span style="width:${p}%;background:${color}"></span></div></div><span class="subjectNum">${d}/${a.length}</span></div>`}).join('');$('subjectOverview').innerHTML=html;$('subjectsPage').innerHTML=html}
function renderAll(){let q=$('searchTasks').value.trim().toLowerCase(),s=$('filterSubject').value,st=$('filterStatus').value,p=$('filterPriority').value;let a=sort(tasks.filter(t=>(!q||(t.name+' '+t.subject+' '+t.notes).toLowerCase().includes(q))&&(s==='all'||t.subject===s)&&(st==='all'||(st==='completed'?t.completed:!t.completed))&&(p==='all'||t.priority===p)));$('allTasks').innerHTML=a.length?a.map(taskHTML).join(''):empty('No tasks match these filters.')}
function calendarMarkup(target,titleId,offset){let y=monthCursor.getFullYear(),m=monthCursor.getMonth(),first=new Date(y,m,1),last=new Date(y,m+1,0);$(titleId).textContent=first.toLocaleDateString(undefined,{month:'long',year:'numeric'});let html=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<div class="weekday">${d}</div>`).join('');let start=new Date(y,m,1-first.getDay());for(let i=0;i<42;i++){let d=new Date(start);d.setDate(start.getDate()+i);let key=iso(d),dayTasks=sort(tasks.filter(t=>t.date===key));html+=`<div class="day ${d.getMonth()!==m?'other':''} ${key===isoToday()?'today':''} ${key===selectedDate?'selected':''}" data-date="${key}" tabindex="0" role="button" aria-label="${esc(niceDate(key))}"><div class="daynum">${d.getDate()}</div>${dayTasks.slice(0,2).map(t=>`<span class="event ${t.completed?'done':''}" title="${esc(t.name)}">${esc(t.time? t.time+' ':'')+esc(t.name)}</span>`).join('')}${dayTasks.length>2?`<span class="event">+${dayTasks.length-2} more</span>`:''}</div>`}$(target).innerHTML=html}
function renderMiniCalendar(){calendarMarkup('miniCalendar','miniTitle');}
function renderCalendar(){calendarMarkup('fullCalendar','calTitle');$('selectedTitle').textContent='Tasks · '+niceDate(selectedDate,{weekday:'long',month:'long',day:'numeric'});let a=sort(tasks.filter(t=>t.date===selectedDate));$('selectedTasks').innerHTML=a.length?a.map(taskHTML).join(''):empty('No tasks on this date.');}
function render(){renderDashboard();renderAll();renderCalendar()}
function go(view){if(!document.getElementById('view-'+view))view='dashboard';document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.id==='view-'+view));document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===view));const names={dashboard:'Dashboard',tasks:'All Tasks',calendar:'Study Calendar',add:$('editId').value?'Edit Task':'Add a Task',subjects:'Subjects',settings:'Settings'};$('pageTitle').textContent=names[view];if(view==='add')setTimeout(()=>$('taskName').focus(),80);if(view==='calendar')renderCalendar();if(view==='tasks')renderAll();window.scrollTo({top:0,behavior:'smooth'})}
function resetForm(){ $('taskForm').reset();$('editId').value='';$('taskDate').value=selectedDate||isoToday();$('taskTime').value='16:00';$('taskPriority').value='Medium';$('formHeading').textContent='Create a study task';$('saveBtn').textContent='Save task';$('formNotice').className='notice';$('formNotice').textContent='';}
function editTask(taskId){let t=tasks.find(x=>x.id===taskId);if(!t)return;resetForm();$('editId').value=t.id;$('taskName').value=t.name;$('taskSubject').value=t.subject;$('taskPriority').value=t.priority;$('taskDate').value=t.date;$('taskTime').value=t.time;$('taskNotes').value=t.notes;$('formHeading').textContent='Edit study task';$('saveBtn').textContent='Update task';go('add')}
function handleAction(e){let b=e.target.closest('[data-action]');if(!b)return;let t=tasks.find(x=>x.id===b.dataset.id);if(!t)return;if(b.dataset.action==='toggle'){t.completed=b.checked;save();render();toast(t.completed?'Task completed!':'Task marked pending.')}else if(b.dataset.action==='edit')editTask(t.id);else if(b.dataset.action==='delete'){if(confirm('Delete this task?')){tasks=tasks.filter(x=>x.id!==t.id);save();render();toast('Task deleted.')}}}
document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{if(b.dataset.view==='add')resetForm();go(b.dataset.view)}));document.addEventListener('click',e=>{let goBtn=e.target.closest('[data-goto]');if(goBtn){if(goBtn.dataset.goto==='add')resetForm();go(goBtn.dataset.goto);return}handleAction(e)});document.addEventListener('change',e=>{if(e.target.matches('[data-action="toggle"]'))handleAction(e)});
$('taskForm').addEventListener('submit',e=>{e.preventDefault();let name=$('taskName').value.trim();if(!name){$('taskName').focus();return}let edit=$('editId').value;let obj={id:edit||id(),name,subject:$('taskSubject').value,date:$('taskDate').value,time:$('taskTime').value||'16:00',priority:$('taskPriority').value,notes:$('taskNotes').value.trim(),completed:edit?(tasks.find(t=>t.id===edit)?.completed||false):false,createdAt:edit?(tasks.find(t=>t.id===edit)?.createdAt||new Date().toISOString()):new Date().toISOString()};if(!obj.date){$('taskDate').focus();return}if(edit){tasks=tasks.map(t=>t.id===edit?obj:t)}else tasks.push(obj);if(!save())return;selectedDate=obj.date;monthCursor=parseDate(obj.date);resetForm();render();go('dashboard');toast(edit?'Task updated successfully!':'Task added successfully!');});
$('cancelForm').addEventListener('click',()=>{resetForm();go('dashboard')});$('calendarAdd').addEventListener('click',()=>{resetForm();$('taskDate').value=selectedDate;go('add')});$('searchTasks').addEventListener('input',renderAll);['filterSubject','filterStatus','filterPriority'].forEach(x=>$(x).addEventListener('change',renderAll));
function shiftMonth(n){monthCursor=new Date(monthCursor.getFullYear(),monthCursor.getMonth()+n,1);renderMiniCalendar();renderCalendar()}['miniPrev','calPrev'].forEach(x=>$(x).addEventListener('click',()=>shiftMonth(-1)));['miniNext','calNext'].forEach(x=>$(x).addEventListener('click',()=>shiftMonth(1)));$('calToday').addEventListener('click',()=>{monthCursor=new Date();selectedDate=isoToday();renderCalendar()});
document.addEventListener('click',e=>{let day=e.target.closest('[data-date]');if(!day)return;selectedDate=day.dataset.date;renderMiniCalendar();renderCalendar()});document.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches('[data-date]')){e.preventDefault();selectedDate=e.target.dataset.date;renderMiniCalendar();renderCalendar()}});
$('exportBtn').addEventListener('click',()=>{let blob=new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='smart-study-planner-backup.json';a.click();URL.revokeObjectURL(url);toast('Backup exported.')});$('importFile').addEventListener('change',async e=>{let file=e.target.files[0];if(!file)return;try{let arr=JSON.parse(await file.text());if(!Array.isArray(arr))throw Error('Backup should contain a task list');let cleaned=arr.map(t=>({id:String(t.id||id()),name:String(t.name||t.title||'Untitled task'),subject:SUBJECTS.some(s=>s[0]===t.subject)?t.subject:'Other',date:/^\d{4}-\d{2}-\d{2}$/.test(t.date||'')?t.date:isoToday(),time:t.time||'16:00',priority:['High','Medium','Low'].includes(t.priority)?t.priority:'Medium',notes:String(t.notes||''),completed:!!t.completed,createdAt:t.createdAt||new Date().toISOString()}));if(!confirm('Replace current tasks with '+cleaned.length+' imported tasks?'))return;tasks=cleaned;save();render();toast('Backup imported successfully.')}catch(err){alert('Could not import file. Please choose a valid planner JSON backup.')}finally{e.target.value=''}});$('clearBtn').addEventListener('click',()=>{if(confirm('Delete all tasks permanently?')){tasks=[];save();render();toast('All tasks cleared.')}});
function init(){SUBJECTS.forEach(([s])=>{ $('taskSubject').add(new Option(s,s));$('filterSubject').add(new Option(s,s)) });let now=new Date();$('topDate').textContent=now.toLocaleDateString(undefined,{weekday:'long',month:'short',day:'numeric',year:'numeric'});$('todayPill').textContent='📅 '+niceDate(isoToday(),{month:'short',day:'numeric',year:'numeric'});$('heroDay').textContent=now.getDate();$('heroMonth').textContent=now.toLocaleDateString(undefined,{month:'long',year:'numeric'}).toUpperCase();let h=now.getHours();$('greeting').textContent=(h<12?'Good morning':h<17?'Good afternoon':'Good evening')+'! Let’s make today count ✨';$('taskDate').value=isoToday();load();render()}
init();
})();
</script></body></html>
